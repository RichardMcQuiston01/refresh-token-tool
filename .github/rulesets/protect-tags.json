{
  "id": 25525885,
  "name": "protect-tags",
  "target": "tag",
  "source_type": "Repository",
  "source": "RichardMcQuiston01/html-to-lvgl",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/tags/[0-9]*.[0-9]*.[0-9]*",
        "refs/tags/v[0-9]*.[0-9]*.[0-9]*"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "creation"
    },
    {
      "type": "update"
    }
  ],
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ]
}